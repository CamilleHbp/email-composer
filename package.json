{
  "name": "mail-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --import tsx server/dev.ts",
    "dev:services": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host localhost --strictPort\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts server/manage.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/manage.ts migrate",
    "admin:create": "node --env-file-if-exists=.env --import tsx server/manage.ts admin",
    "storage:configure": "node --env-file-if-exists=.env --import tsx server/manage.ts storage",
    "storage:verify": "node --env-file-if-exists=.env --import tsx server/manage.ts verify-storage"
  },
  "overrides": {
    "@esbuild-kit/core-utils": { "esbuild": "^0.28.2" }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/dm-sans": "^5.0.0",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.468.0",
    "mjml": "^5.4.1",
    "mjml-browser": "^5.4.1",
    "nodemailer": "^10.1.7",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/mjml": "^4.7.4",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@electric-sql/pglite": "^0.3.14",
    "@types/mailparser": "^3.4.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.2",
    "mailparser": "^3.7.0",
    "roosterjs": "8.47.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
